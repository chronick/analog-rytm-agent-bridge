{
  "name": "analog-rytm-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone agent bridge for semantic Analog Rytm control.",
  "bin": {
    "rytm-mcp-server": "src/bin/mcp-server.ts"
  },
  "scripts": {
    "mcp": "node --experimental-transform-types src/bin/mcp-server.ts",
    "mcp:hardware": "node --experimental-transform-types src/bin/mcp-server.ts --adapter hardware --clock-source observed",
    "test": "node --experimental-transform-types --test test/*.test.ts",
    "typecheck": "tsc",
    "rust:test": "cd daemon && cargo test",
    "check": "npm test && npm run typecheck && npm run rust:test",
    "demo": "node --experimental-transform-types src/bin/mock-demo.ts",
    "hardware:control": "node --experimental-transform-types src/bin/verify-hardware-control.ts",
    "hardware:all": "node --experimental-transform-types src/bin/verify-hardware-all.ts",
    "hardware:macros": "node --experimental-transform-types src/bin/verify-hardware-macros.ts",
    "hardware:overbridge": "node --experimental-transform-types src/bin/verify-hardware-overbridge.ts",
    "hardware:audio": "node --experimental-transform-types src/bin/verify-hardware-audio.ts",
    "hardware:samples": "node --experimental-transform-types src/bin/verify-hardware-samples.ts",
    "hardware:songs": "node --experimental-transform-types src/bin/verify-hardware-songs.ts",
    "hardware:scheduler": "node --experimental-transform-types src/bin/verify-hardware-scheduler.ts",
    "gen:bank": "node --experimental-transform-types src/bin/generate-bank.ts",
    "euclid:gen": "node --experimental-transform-types src/bin/euclid-gen.ts",
    "build:project": "node --experimental-transform-types src/bin/build-project.ts",
    "lint:declaration": "node --experimental-transform-types src/bin/lint-declaration.ts",
    "lint:arrangement": "node --experimental-transform-types src/bin/lint-arrangement.ts",
    "analyze:render": "node --experimental-transform-types src/bin/analyze-render.ts",
    "score:danceability": "node --experimental-transform-types src/bin/score-danceability.ts",
    "score:idm": "node --experimental-transform-types src/bin/score-idm.ts",
    "audition:project": "node --experimental-transform-types src/bin/audition-project.ts",
    "render:score": "node --experimental-transform-types src/bin/render-score.ts",
    "audition:solo": "node --experimental-transform-types src/bin/audition-solo.ts"
  },
  "engines": {
    "node": ">=22.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
